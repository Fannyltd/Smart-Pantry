
# Base de données (SQLite par défaut, dans data/)
DATABASE_URL=sqlite:///data/smart_pantry.db

# TheMealDB (clé de test publique "1" pour le développement)
API_ENABLED=true
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1
MEALDB_API_KEY=1
API_TIMEOUT=8
MAX_API_INGREDIENTS=5
MAX_API_RECIPES=15
DEFAULT_SERVINGS=4

# Péremption
EXPIRATION_WARNING_DAYS=3
PRIORITY_HORIZON_DAYS=7

# Recommandation : Score(r) = C_WEIGHT * C(r) + P_WEIGHT * P(r)  (somme = 1)
SCORE_COVERAGE_WEIGHT=0.6
SCORE_PRIORITY_WEIGHT=0.4
FUZZY_MATCH_THRESHOLD=0.85

# Statistiques
MIN_HISTORY_MOVEMENTS=3
DEFAULT_PERIOD_DAYS=30

# Allergènes exclus des recommandations (séparés par des virgules)
USER_ALLERGENS=
